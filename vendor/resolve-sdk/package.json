{
  "name": "@resolve-protocol/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Resolve prediction market protocol on Stellar/Soroban",
  "license": "Apache-2.0",
  "author": "Resolve Protocol",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "keywords": [
    "stellar",
    "soroban",
    "prediction-market",
    "resolve",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolve-web/resolve-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/resolve-web/resolve-sdk/issues"
  },
  "homepage": "https://github.com/resolve-web/resolve-sdk#readme"
}
